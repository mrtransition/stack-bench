{
  "name": "stack-bench",
  "version": "0.1.3",
  "description": "Local-first toolbox for full-stack engineers — zero build, no data upload.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "homepage": "https://mrtransition.github.io/stack-bench/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrtransition/stack-bench.git"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "serve": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs --agent",
    "open": "node scripts/dev.mjs --open",
    "agent": "node agent/agent.js",
    "test": "node --test tests/*.test.mjs",
    "selftest:examples": "node tests/manual/examples-selftest.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
